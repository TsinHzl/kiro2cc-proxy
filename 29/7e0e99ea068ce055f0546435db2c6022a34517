cret,\n      region,\n      authMethod,\n      startUrl,\n      profileArn,\n      provider,\n      tokenEndpoint,\n      scopes,\n      ...rest\n    } = obj\n    return {\n      ...rest,\n      credentials: {\n        refreshToken,\n        clientId,\n        clientSecret,\n        region,\n        authMethod,\n        startUrl,\n        profileArn,\n        provider,\n        tokenEndpoint,\n        scopes,\n      },\n    }\n  }\n  return item\n}\n\n// 解析 KAM 导出 JSON，支持单账号和多账号格式，兼容扁平 refreshToken 结构\nexport function parseKamJson(raw: string, t: TFunction): KamAccount[] {\n  const parsed = JSON.parse(raw)\n\n  let rawItems: unknown[]\n\n  // 标准 KAM 导出格式：{ version, accounts: [...] }\n  if (parsed.accounts && Array.isArray(parsed.accounts)) {\n    rawItems = parsed.accounts\n  }\n  // 兜底：如果直接是账号数组\n  else if (Array.isArray(parsed)) {\n    rawItems = parsed\n  }\n  // 单个账号对象（有 credentials 字段）\n  else if (parsed.credentials && typeof parsed.credentials === 'object') {\n    rawItems = [parsed]\n  }\n  // 单个扁平对象（顶层有 refreshToken）\n  else if (typeof parsed.refreshToken === 'string') {\n    rawItems = [parsed]\n  }\n  else {\n    throw new Error(t('credentials.invalidKamJsonFormat'))\n  }\n\n  // 适配扁平结构为 KAM 嵌套结构\n  rawItems = rawItems.map(normalizeToKamAccount)\n\n  const validAccounts = rawItems.filter(isValidKamAccount)\n\n  if (rawItems.length > 0 && validAccounts.length === 0) {\n    throw new Error(t('credentials.allRecordsMissingToken', { count: rawItems.length }))\n  }\n\n  if (validAccounts.length < rawItems.length) {\n    const skipped = rawItems.length - validAccounts.length\n    console.warn(`KAM 导入：跳过 ${skipped} 条缺少有效 credentials.refreshToken 的记录`)\n  }\n\n  return validAccounts\n}\n\nexport function buildCredentialImportRequest(\n  input: CredentialImportInput,\n  t?: TFunction,\n): AddCredentialRequest {\n  const clientId = input.clientId?.trim() || undefined\n  const clientSecret = input.clientSecret?.trim() || undefined\n  const tokenEndpoint = input.tokenEndpoint?.trim() || undefined\n  const explicitAuthMethod = input.authMethod?.trim().toLowerCase()\n  const authMethod: NonNullable<AddCredentialRequest['authMethod']>\n    = explicitAuthMethod === 'external_idp'\n      ? 'external_idp'\n      : explicitAuthMethod === 'idc'\n        ? 'idc'\n        : explicitAuthMethod === 'social'\n          ? 'social'\n          : clientId && clientSecret ? 'idc' : 'social'\n\n  if (authMethod === 'external_idp' && (!clientId || !tokenEndpoint)) {\n    throw new Error(t?.('credentials.externalIdpRequiresClientIdAndTokenEndpoint')\n      ?? 'credentials.externalIdpRequiresClientIdAndTokenEndpoint')\n  }\n  if ((authMethod === 'idc' && (!clientId || !clientSecret))\n    || (authMethod === 'social' && (clientId || clientSecret))) {\n    throw new Error(t?.('credentials.idcRequiresBoth') ?? 'credentials.idcRequiresBoth')\n  }\n\n  return {\n    refreshToken: input.refreshToken.trim(),\n    authMethod,\n    email: input.email?.trim() || input.nickname?.trim() || undefined,\n    authRegion: input.authRegion?.trim() || input.region?.trim() || undefined,\n    apiRegion: input.apiRegion?.trim() || undefined,\n    clientId,\n    clientSecret,\n    provider: input.provider?.trim() || undefined,\n    tokenEndpoint,\n    scopes: input.scopes?.trim() || undefined,\n    profileArn: input.profileArn?.trim() || undefined,\n    priority: input.priority,\n    machineId: input.machineId?.trim() || undefined,\n  }\n}\n\nexport function buildKamAddCredentialRequest(\n  account: KamAccount,\n  t?: TFunction,\n): AddCredentialRequest {\n  return buildCredentialImportRequest({\n    refreshToken: account.credentials.refreshToken,\n    authMethod: account.credentials.authMethod,\n    email: account.email,\n    nickname: account.nickname,\n    clientId: account.credentials.clientId,\n    clientSecret: account.credentials.clientSecret,\n    provider: account.credentials.provider,\n    tokenEndpoint: account.credentials.tokenEndpoint,\n    scopes: account.credentials.scopes,\n    profileArn: account.credentials.profileArn,\n    region: account.credentials.region,\n    machineId: account.machineId,\n  }, t)\n}\n",
