voiding` 已从原始 ID 集改为：\n\n```rust\nlet base_ids = self.effective_candidate_ids(model, allowed_ids);\n```\n\n文件 sticky 命中已增加同一模型资格判断：\n\n```rust\nlet requires_opus = Self::model_requires_opus(model);\n```\n\n缓存账号谓词已包含：\n\n```rust\nSelf::is_effective_candidate(e, requires_opus, allowed_ids)\n```\n\n文件 priority current 快路径在 GREEN CR 后改为区分模型临时 fallback。当前核心模式为：\n\n```rust\nlet (id, credentials, preserve_current_id) = {\n    let is_balanced = self.load_balancing_mode.lock().as_str() == \"balanced\";\n\n    let (current_hit, preserve_current_id) = if is_balanced {\n        (None, false)\n    } else {\n        let entries = self.entries.lock();\n        let current_id = *self.current_id.lock();\n        let requires_opus = Self::model_requires_opus(model);\n        let current_entry = entries.iter().find(|e| {\n            e.id == current_id\n                && !e.disabled\n                && Self::compute_health(e) != HealthStatus::Unhealthy\n        });\n        let preserve_current_id = current_entry\n            .is_some_and(|e| !Self::is_effective_candidate(e, requires_opus, &[]));\n        let current_hit = current_entry\n            .filter(|e| Self::is_effective_candidate(e, requires_opus, &[]))\n            .map(|e| (e.id, e.credentials.clone()));\n        (current_hit, preserve_current_id)\n    };\n\n    if let Some(hit) = current_hit {\n        (hit.0, hit.1, preserve_current_id)\n    } else {\n        let mut best = self.select_next_credential(model, &[]);\n        // 原有自愈逻辑保持不变。\n        if let Some((new_id, new_creds)) = best {\n            if !preserve_current_id {\n                let mut current_id = self.current_id.lock();\n                *current_id = new_id;\n            }\n            (new_id, new_creds, preserve_current_id)\n        } else {\n            anyhow::bail!(\"{}\", self.describe_unavailable(model, &[]));\n        }\n    }\n};\n```\n\nToken 获取失败后的全局切换同样受保护：\n\n```rust\nif !preserve_current_id {\n    self.switch_to_next_by_priority();\n}\n```