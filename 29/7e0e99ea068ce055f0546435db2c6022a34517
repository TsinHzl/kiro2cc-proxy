            "new_string": "/**\n * 邮箱脱敏（设计稿 `h∗∗∗∗∗∗∗∗＠gmail.com`）：保留本地部分首字符与完整域名，其余打星。\n * 仅为表格单行紧凑展示，不是安全措施 —— 行内 `title` 仍给出完整值（管理端本就明文可见）。\n */\nexport function maskEmail(email: string): string {\n  const at = email.indexOf('@')\n  if (at <= 0) return email\n  const local = email.slice(0, at)\n  // 首字符按码点取，与头像首字母同口径，避免 emoji / 代理对开头的本地部分被截半\n  const first = [...local][0] ?? ''\n  return `${first}${'∗'.repeat(Math.max(1, local.length - first.length))}＠${email.slice(at + 1)}`\n}\n\n/**\n * 视觉超额判定（带浮点容差）：`used > limit + 1e-9 * max(1, |used|, |limit|)`。\n * 目的：`100.00000005/100` 这类浮点误差不触发红色超额样式，`100.000001/100` 才算超额。\n * 非有限输入（NaN/Inf）一律不判为超额，避免脏数据点亮异常样式。\n */\nexport function isVisuallyOverQuota(used: number, limit: number): boolean {\n  if (!Number.isFinite(used) || !Number.isFinite(limit)) return false\n  const tolerance = 1e-9 * Math.max(1, Math.abs(used), Math.abs(limit))\n  return used > limit + tolerance\n}",
